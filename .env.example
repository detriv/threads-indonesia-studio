# Salinan templat untuk .env. Jangan salin nilai asli ke repo.
# Cara pakai:  cp -n .env.example .env   lalu isi nilainya, chmod 600 .env
# File .env TIDAK ikut version control (lihat .gitignore).

POSTGRES_DB=threads_id
POSTGRES_USER=threads
POSTGRES_PASSWORD=ganti-dengan-password-lokal
DATABASE_URL=postgres://threads:ganti-dengan-password-lokal@db:5432/threads_id
API_PORT=3000
DEMO_MODE=true
VITE_API_BASE=/api
TZ=Asia/Jakarta

# Isi lewat npm run hash-password. Tidak ada login bawaan.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Phase 2 generation, independent from DEMO_MODE publication gate.
GENERATION_PROVIDER=simulation
GENERATION_DAILY_LIMIT=20
# No default live model: choose an available generateContent model explicitly.
GEMINI_MODEL=
GEMINI_MODEL_IDEAS=
GEMINI_MODEL_SHORT=
GEMINI_MODEL_DEEP=
GEMINI_MODEL_REVISE=
GEMINI_MODEL_TRY_THEME=
# Key only passed to worker. Never VITE_*, URL, frontend, or chat.
GEMINI_API_KEY=
# Enable only after separate operator authorization for outbound generation.
GEMINI_ALLOW_OUTBOUND=false
# Optional exact-model prices verified by operator; absent/unknown -> null, not zero.
GEMINI_PRICING_JSON=

# Phase 3: Meta Threads (default mati; jangan isi tanpa rencana uji).
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_SCOPES=threads_basic,threads_content_publish,threads_manage_replies,threads_read_replies
THREADS_LIVE_POSTING=false
# Meta mewajibkan callback https. Isi URL publik (tunnel/domain) + path yang sama dengan rute API.
THREADS_OAUTH_REDIRECT=https://ganti-dengan-host-publik/api/threads/oauth-callback
# Tempat token long-lived disimpan API saat OAuth (file 0600, dibaca worker).
THREADS_TOKEN_FILE=/tmp/threads-worker-token
